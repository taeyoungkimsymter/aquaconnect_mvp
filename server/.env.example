# Railway injects DATABASE_URL automatically once you attach a Postgres
# plugin to this service — you normally don't set it by hand there.
# For local development, point it at any Postgres you have running:
DATABASE_URL=postgres://user:password@localhost:5432/aquaconnect

# Any long random string — used to sign login JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional — falls back to a shared demo key baked into src/lib/nifs.js
# (same default D:\202609\index.mjs used) if unset.
NIFS_API_KEY=

# Password seeded for the demo login (leedonggil@haegang.kr) by `npm run seed`.
SEED_DEMO_PASSWORD=demo1234

PORT=8080

# AI 리포트(Gemini, OpenAI 호환 API). 키는 서버 환경변수에만 둡니다 — 앱·저장소에 넣지 마세요.
# MODEL_API_KEY 가 비어 있으면 AI 리포트는 '미연결'로 표시되고 만들 수 없습니다.
MODEL_API_KEY=
# 비우면 Gemini 기본값(https://generativelanguage.googleapis.com/v1beta/openai, gemini-3.5-flash)
MODEL_BASE_URL=
MODEL_NAME=
# 추론 토큰이 출력 한도를 함께 쓰는 Gemini 용. 비우면 low
MODEL_REASONING_EFFORT=
# 응답 대기(ms). 비우면 180000
MODEL_TIMEOUT_MS=
# 결제를 연결해 하루 한도가 늘었으면 모델별로 덮어씁니다(앱의 '남은 횟수' 계산용). 예: {"gemini-3.5-flash":10000}
MODEL_DAILY_LIMITS=
